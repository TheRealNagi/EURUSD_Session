<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EURUSD M30 Session Analysis</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@300;400;600&display=swap');

  :root {
    --bg: #0a0c0f;
    --bg2: #111318;
    --bg3: #181c24;
    --border: #1e2430;
    --accent: #00d4aa;
    --accent2: #ff6b35;
    --accent3: #5b8def;
    --accent4: #f7c948;
    --text: #d4dae8;
    --text-dim: #6b7894;
    --text-bright: #eef2ff;
    --green: #2ecc71;
    --red: #e74c3c;
    --yellow: #f7c948;
    --mono: 'IBM Plex Mono', monospace;
    --sans: 'IBM Plex Sans', sans-serif;
  }

  * { margin:0; padding:0; box-sizing:border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    font-size: 13px;
    line-height: 1.6;
    padding: 32px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .report-header {
    border-bottom: 1px solid var(--accent);
    padding-bottom: 20px;
    margin-bottom: 36px;
  }

  .report-header h1 {
    font-family: var(--mono);
    font-size: 22px;
    color: var(--accent);
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .report-header .meta {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-dim);
    margin-top: 6px;
    display: flex;
    gap: 32px;
  }

  .report-header .meta span { color: var(--text); }

  .section {
    margin-bottom: 44px;
  }

  .section-title {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .section-title::before {
    content: '//';
    color: var(--text-dim);
  }

  .section-num {
    color: var(--text-dim);
    margin-right: 4px;
  }

  /* AUDIT TABLE */
  .audit-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .audit-cell {
    background: var(--bg2);
    padding: 12px 16px;
  }

  .audit-cell .label {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 4px;
  }

  .audit-cell .value {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--text-bright);
  }

  .audit-cell .value.warn { color: var(--yellow); }
  .audit-cell .value.ok   { color: var(--green); }

  /* STANDARD TABLE */
  table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--mono);
    font-size: 11.5px;
  }

  thead tr {
    background: var(--bg3);
    border-bottom: 1px solid var(--accent);
  }

  thead th {
    padding: 8px 10px;
    text-align: right;
    color: var(--text-dim);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  thead th:first-child { text-align: left; }

  tbody tr {
    border-bottom: 1px solid var(--border);
  }

  tbody tr:hover { background: var(--bg3); }

  tbody td {
    padding: 7px 10px;
    text-align: right;
    color: var(--text);
  }

  tbody td:first-child {
    text-align: left;
    color: var(--accent);
    font-weight: 600;
  }

  .pos { color: var(--green) !important; }
  .neg { color: var(--red) !important; }
  .neutral { color: var(--text-dim) !important; }
  .highlight { color: var(--accent4) !important; font-weight: 600; }
  .strong-tag { 
    background: rgba(0,212,170,0.12); 
    color: var(--accent); 
    padding: 2px 6px; 
    border-radius: 2px; 
    font-size: 10px;
  }
  .noise-tag { 
    background: rgba(107,120,148,0.15); 
    color: var(--text-dim); 
    padding: 2px 6px; 
    border-radius: 2px; 
    font-size: 10px;
  }
  .warn-tag {
    background: rgba(247,201,72,0.12);
    color: var(--yellow);
    padding: 2px 6px;
    border-radius: 2px;
    font-size: 10px;
  }

  /* INTERPRETATION BLOCK */
  .interp {
    background: var(--bg2);
    border-left: 2px solid var(--accent3);
    padding: 14px 18px;
    margin-top: 12px;
    font-size: 12px;
    line-height: 1.7;
    color: var(--text);
  }

  .interp strong { color: var(--text-bright); }
  .interp .dim { color: var(--text-dim); font-style: italic; }

  /* INSIGHT TABLE */
  .insight-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    margin-top: 10px;
  }

  .insight-cell {
    background: var(--bg2);
    padding: 10px 14px;
  }

  .insight-cell .ic-label {
    font-size: 10px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 3px;
    font-family: var(--mono);
  }

  .insight-cell .ic-val {
    font-size: 12px;
    color: var(--text-bright);
    font-family: var(--mono);
  }

  .insight-cell .ic-note {
    font-size: 10px;
    color: var(--text-dim);
    margin-top: 3px;
  }

  /* SESSION BADGE */
  .sesh {
    display: inline-block;
    padding: 2px 7px;
    border-radius: 2px;
    font-size: 10px;
    font-family: var(--mono);
    font-weight: 600;
  }
  .sesh-london { background: rgba(91,141,239,0.15); color: var(--accent3); }
  .sesh-lnny   { background: rgba(0,212,170,0.15); color: var(--accent); }
  .sesh-ny     { background: rgba(255,107,53,0.15); color: var(--accent2); }
  .sesh-tokyo  { background: rgba(247,201,72,0.12); color: var(--yellow); }
  .sesh-sydney { background: rgba(107,120,148,0.12); color: var(--text-dim); }

  /* FINAL SUMMARY */
  .summary-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--accent);
  }

  .summary-row {
    display: contents;
  }

  .summary-q {
    background: var(--bg3);
    padding: 10px 16px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-dim);
    border-bottom: 1px solid var(--border);
  }

  .summary-a {
    background: var(--bg2);
    padding: 10px 16px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-bright);
    border-bottom: 1px solid var(--border);
  }

  .disclaimer {
    margin-top: 36px;
    padding: 14px 18px;
    border: 1px solid var(--border);
    font-size: 11px;
    color: var(--text-dim);
    font-family: var(--mono);
    line-height: 1.6;
  }

  .disclaimer strong { color: var(--accent2); }

  .vol-bar-container {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .vol-bar {
    height: 6px;
    background: var(--accent);
    border-radius: 1px;
    display: inline-block;
  }

  h3.sub {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-dim);
    margin: 18px 0 8px 0;
    letter-spacing: 0.05em;
  }

  .anomaly-box {
    border: 1px solid var(--accent4);
    background: rgba(247,201,72,0.04);
    padding: 14px 18px;
    margin-top: 12px;
    font-size: 12px;
  }

  .anomaly-box .anom-title {
    font-family: var(--mono);
    color: var(--accent4);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 8px;
  }
</style>
</head>
